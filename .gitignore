# Build outputs (rebuild via src/build.bat)
tools/*.exe
tools/*.dll
src/*.obj
src/*.pdb

# Datasets and checkpoints. Regenerable from seed: room geometry, agent
# placement, transforms and analytic labels are byte-identical across runs;
# the Steam Audio reflection RENDER carries ~1% run-to-run stochastic jitter in
# cluttered scenes (NOT bit-deterministic -- E2's determinism was a simple
# single-wall scene), which is harmless / mild augmentation, not reproducible
# byte-for-byte. So: statistically regenerable, not tracked.
jepa_data/
swarm_data/
*.npz
*.pt
*.ckpt

# Python venv / caches
.venv/
__pycache__/
*.pyc

# Rendered scene outputs (regenerable via scene_dump.exe + render_scenes.py)
results/scenes/
